000014AE                           562  *-----------------------------------------------------------
000014AE                           563  * Subroutine    : Check Self Collision
000014AE                           564  * Description   : HANDLING DAMAGE extension.
000014AE                           565  *                 After the head has moved, compare it against
000014AE                           566  *                 every body segment from index 2 to LEN-1.
000014AE                           567  *                 Index 0 is the head itself.
000014AE                           568  *                 Index 1 is the neck - the cell the head just
000014AE                           569  *                 left - which is always adjacent and can never
000014AE                           570  *                 cause a real self-collision, so it is skipped.
000014AE                           571  *                 On a hit the same shield/dead logic used for
000014AE                           572  *                 wall contact applies: spend one shield (with
000014AE                           573  *                 sound) or end the game if shields are empty.
000014AE                           574  *                 Registers used: D0=length, D1=loop index,
000014AE                           575  *                 D2=head X, D3=head Y, D4=segment byte, A0=ptr.
000014AE                           576  *                 All saved and restored via MOVEM.
000014AE                           577  *-----------------------------------------------------------
000014AE                           578  
000014AE                           579  CHECK_SELF_COLLISION:
000014AE  48E7 F880                580      MOVEM.L D0-D4/A0,   -(SP)
000014B2                           581  
000014B2  4280                     582      CLR.L   D0
000014B4  1039 00001CE7            583      MOVE.B  SNAKE_LEN,  D0
000014BA  B03C 0003                584      CMP.B   #3,         D0          ; Need at least 3 segments to
000014BE  6D00 0040                585      BLT     CSC_DONE                ; be able to collide with body
000014C2                           586  
000014C2  4282                     587      CLR.L   D2
000014C4  4283                     588      CLR.L   D3
000014C6  1439 00001CE4            589      MOVE.B  SNAKE_X,    D2          ; D2 = head X
000014CC  1639 00001CE5            590      MOVE.B  SNAKE_Y,    D3          ; D3 = head Y
000014D2                           591  
000014D2  123C 0002                592      MOVE.B  #2,         D1          ; Start checking from index 2
000014D6                           593  
000014D6                           594  CSC_LOOP:
000014D6  4284                     595      CLR.L   D4
000014D8  41F9 00001CFA            596      LEA     BODY_X,     A0
000014DE  D0C1                     597      ADDA.W  D1,         A0
000014E0  1810                     598      MOVE.B  (A0),       D4          ; D4 = BODY_X[i]
000014E2  B802                     599      CMP.B   D2,         D4          ; Matches head X?
000014E4  6600 0014                600      BNE     CSC_NEXT
000014E8                           601  
000014E8  4284                     602      CLR.L   D4
000014EA  41F9 00001D18            603      LEA     BODY_Y,     A0
000014F0  D0C1                     604      ADDA.W  D1,         A0
000014F2  1810                     605      MOVE.B  (A0),       D4          ; D4 = BODY_Y[i]
000014F4  B803                     606      CMP.B   D3,         D4          ; Matches head Y?
000014F6  6700 000E                607      BEQ     CSC_HIT                 ; Both match: self-collision!
000014FA                           608  
000014FA                           609  CSC_NEXT:
000014FA  5201                     610      ADD.B   #1,         D1
000014FC  B200                     611      CMP.B   D0,         D1          ; Reached LEN?
000014FE  6DD6                     612      BLT     CSC_LOOP
00001500                           613  
00001500                           614  CSC_DONE:
00001500  4CDF 011F                615      MOVEM.L (SP)+,      D0-D4/A0
00001504  4E75                     616      RTS
00001506                           617  
00001506                           618  CSC_HIT:
00001506  4CDF 011F                619      MOVEM.L (SP)+,      D0-D4/A0    ; Restore before branching out
0000150A  4A39 00001CF1            620      TST.B   SHIELD
00001510  6700 04C4                621      BEQ     DEAD                    ; No shields left: game over
00001514  5339 00001CF1            622      SUB.B   #1,         SHIELD      ; Spend one shield
0000151A  6100 0566                623      BSR     PLAY_OPPS               ; Audio cue
0000151E  4E75                     624      RTS
00001520                           625  
00001520                           626  *-----------------------------------------------------------
00001520                           627  * Subroutine    : Check Food
00001520                           628  *-----------------------------------------------------------
00001520                           629  
00001520                           630  CHECK_FOOD:
00001520  1239 00001CE4            631      MOVE.B  SNAKE_X,    D1
00001526  1439 00001CE8            632      MOVE.B  FOOD_X,     D2
0000152C  B401                     633      CMP.B   D1,         D2
0000152E  6600 0076                634      BNE     NO_EAT
00001532                           635  
00001532  1239 00001CE5            636      MOVE.B  SNAKE_Y,    D1
00001538  1439 00001CE9            637      MOVE.B  FOOD_Y,     D2
0000153E  B401                     638      CMP.B   D1,         D2
00001540  6600 0064                639      BNE     NO_EAT
00001544                           640  
00001544  6100 053C                641      BSR     PLAY_OPPS
00001548  52B9 00001CE0            642      ADD.L   #POINTS,    PLAYER_SCORE
0000154E  4EB9 00001ADE            643      JSR     PLACEFOOD
00001554                           644  
00001554  1239 00001CEF            645      MOVE.B  FUEL,       D1
0000155A  0601 0014                646      ADD.B   #FUEL_EAT,  D1
0000155E  B23C 0064                647      CMP.B   #FUEL_MAX,  D1
00001562  6F00 0006                648      BLE     CF_STORE_FUEL
00001566  123C 0064                649      MOVE.B  #FUEL_MAX,  D1
0000156A                           650  
0000156A                           651  CF_STORE_FUEL:
0000156A  13C1 00001CEF            652      MOVE.B  D1,         FUEL
00001570                           653  
00001570  1239 00001CE7            654      MOVE.B  SNAKE_LEN,  D1
00001576  B23C 001E                655      CMP.B   #MAX_SNAKE, D1
0000157A  6C00 0008                656      BGE     CF_NO_GROW
0000157E  5239 00001CE7            657      ADD.B   #1,         SNAKE_LEN
00001584                           658  
00001584                           659  CF_NO_GROW:
00001584  2239 00001CEA            660      MOVE.L  DELAY_COUNT,D1
0000158A  0481 00005000            661      SUB.L   #SPEED_INC, D1
00001590  B2BC 00008000            662      CMP.L   #MIN_DELAY, D1
00001596  6C00 0008                663      BGE     CF_SPEED_STORE
0000159A  223C 00008000            664      MOVE.L  #MIN_DELAY, D1
000015A0                           665  
000015A0                           666  CF_SPEED_STORE:
000015A0  23C1 00001CEA            667      MOVE.L  D1,         DELAY_COUNT
000015A6                           668  
000015A6                           669  NO_EAT:
000015A6  4E75                     670      RTS
000015A8                           671  
000015A8                           672  *-----------------------------------------------------------
000015A8                           673  * Subroutine    : Tick Physics
000015A8                           674  * Description   : All alternative physics systems per tick.
000015A8                           675  *
000015A8                           676  *   1. FUEL DECAY (0.5 per tick)
000015A8                           677  *      FUEL_TICK toggles between 0 and 1 each tick.
000015A8                           678  *      Fuel is only subtracted on the tick where FUEL_TICK
000015A8                           679  *      flips to 1. This gives an average drain of exactly
000015A8                           680  *      0.5 per tick without any floating-point arithmetic.
000015A8                           681  *
000015A8                           682  *   2. BOOST TICK
000015A8                           683  *      Costs BOOST_EXTRA fuel per boosted tick.
000015A8                           684  *      Deactivates when timer or fuel runs out.
000015A8                           685  *
000015A8                           686  *   3. SOLAR FLARE (DYNAMIC EVENT)
000015A8                           687  *      Four distinct states, tested in priority order:
000015A8                           688  *
000015A8                           689  *      FLARE_ACTIVE (state 3):
000015A8                           690  *        Count down FLARE_TIMER. On expiry, zero FLARE_ACTIVE
000015A8                           691  *        and load FLARE_COOL_TICKS into FLARE_COOLDOWN.
000015A8                           692  *
000015A8                           693  *      FLARE_WARNING (state 2):
000015A8                           694  *        Count down FLARE_WARN_TIMER. On expiry, clear
000015A8                           695  *        FLARE_WARNING and activate FLARE_ACTIVE with a
000015A8                           696  *        full FLARE_TICKS countdown. WARN_FLASH toggles
000015A8                           697  *        each warning tick to drive the border flash.
000015A8                           698  *
000015A8                           699  *      FLARE_COOLDOWN (state 1):
000015A8                           700  *        Count down FLARE_COOLDOWN. While > 0 no new flare
000015A8                           701  *        can be triggered. No border change.
000015A8                           702  *
000015A8                           703  *      IDLE (state 0):
000015A8                           704  *        Roll a 1/32 chance each tick. On zero result,
000015A8                           705  *        start FLARE_WARNING and prime FLARE_WARN_TIMER.
000015A8                           706  *-----------------------------------------------------------
000015A8                           707  
000015A8                           708  TICK_PHYSICS:
000015A8                           709  
000015A8                           710      ; --- 1. Fuel Decay at 0.5 per tick ---
000015A8                           711      ; Toggle FUEL_TICK between 0 and 1 each call.
000015A8                           712      ; Only drain fuel when it flips to 1 (every other tick).
000015A8  1239 00001CF0            713      MOVE.B  FUEL_TICK,  D1
000015AE  0A01 0001                714      EOR.B   #1,         D1          ; Flip low bit: 0->1, 1->0
000015B2  13C1 00001CF0            715      MOVE.B  D1,         FUEL_TICK
000015B8  4A01                     716      TST.B   D1
000015BA  6700 002E                717      BEQ     TP_BOOST                ; This is the 0-tick: skip drain
000015BE                           718  
000015BE                           719      ; Drain tick - subtract 1 fuel
000015BE  1239 00001CEF            720      MOVE.B  FUEL,       D1
000015C4  5301                     721      SUB.B   #1,         D1
000015C6  6500 0016                722      BCS     TP_FUEL_EMPTY           ; Underflow: was already 0
000015CA  13C1 00001CEF            723      MOVE.B  D1,         FUEL
000015D0  4A39 00001CEF            724      TST.B   FUEL
000015D6  6700 0006                725      BEQ     TP_FUEL_EMPTY           ; Landed on exactly 0
000015DA  6000 000E                726      BRA     TP_BOOST
000015DE                           727  
000015DE                           728  TP_FUEL_EMPTY:
000015DE  4239 00001CEF            729      CLR.B   FUEL
000015E4  4EF9 000019D6            730      JMP     DEAD
000015EA                           731  
000015EA                           732      ; --- 2. Boost Tick ---
000015EA                           733  TP_BOOST:
000015EA  4A39 00001CF8            734      TST.B   BOOST_ACTIVE
000015F0  6700 002C                735      BEQ     TP_FLARE_STATE
000015F4                           736  
000015F4  1239 00001CEF            737      MOVE.B  FUEL,       D1
000015FA  B23C 0003                738      CMP.B   #BOOST_EXTRA,D1
000015FE  6D00 0012                739      BLT     TP_BOOST_OFF
00001602  5739 00001CEF            740      SUB.B   #BOOST_EXTRA,FUEL
00001608                           741  
00001608  5339 00001CF9            742      SUB.B   #1,         BOOST_TIMER
0000160E  6600 000E                743      BNE     TP_FLARE_STATE
00001612                           744  
00001612                           745  TP_BOOST_OFF:
00001612  4239 00001CF8            746      CLR.B   BOOST_ACTIVE
00001618  4239 00001CF9            747      CLR.B   BOOST_TIMER
0000161E                           748  
0000161E                           749      ; --- 3. Solar Flare state machine ---
0000161E                           750  TP_FLARE_STATE:
0000161E                           751  
0000161E                           752      ; Priority 1: active flare is running
0000161E  4A39 00001CF2            753      TST.B   FLARE_ACTIVE
00001624  6700 001E                754      BEQ     TP_CHECK_WARNING
00001628                           755  
00001628  5339 00001CF3            756      SUB.B   #1,         FLARE_TIMER
0000162E  6600 008E                757      BNE     TP_DONE                 ; Still counting down
00001632  4239 00001CF2            758      CLR.B   FLARE_ACTIVE            ; Flare over
00001638  13FC 0038 00001CF6       759      MOVE.B  #FLARE_COOL_TICKS,FLARE_COOLDOWN ; Start cooldown
00001640  6000 007C                760      BRA     TP_DONE
00001644                           761  
00001644                           762      ; Priority 2: warning phase is running
00001644                           763  TP_CHECK_WARNING:
00001644  4A39 00001CF4            764      TST.B   FLARE_WARNING
0000164A  6700 003C                765      BEQ     TP_CHECK_COOLDOWN
0000164E                           766  
0000164E                           767      ; Toggle the flash flag every warning tick for border flash
0000164E  1239 00001CF7            768      MOVE.B  WARN_FLASH, D1
00001654  0A01 0001                769      EOR.B   #1,         D1
00001658  13C1 00001CF7            770      MOVE.B  D1,         WARN_FLASH
0000165E                           771  
0000165E  5339 00001CF5            772      SUB.B   #1,         FLARE_WARN_TIMER
00001664  6600 0058                773      BNE     TP_DONE                 ; Warning still counting down
00001668                           774  
00001668                           775      ; Warning expired: promote to active flare
00001668  4239 00001CF4            776      CLR.B   FLARE_WARNING
0000166E  4239 00001CF7            777      CLR.B   WARN_FLASH              ; Stop flash, border goes solid
00001674  13FC 0001 00001CF2       778      MOVE.B  #1,         FLARE_ACTIVE
0000167C  13FC 0019 00001CF3       779      MOVE.B  #FLARE_TICKS,FLARE_TIMER
00001684  6000 0038                780      BRA     TP_DONE
00001688                           781  
00001688                           782      ; Priority 3: cooldown is running (block new flares)
00001688                           783  TP_CHECK_COOLDOWN:
00001688  4A39 00001CF6            784      TST.B   FLARE_COOLDOWN
0000168E  6700 000C                785      BEQ     TP_IDLE                 ; Cooldown over: allow new flare
00001692                           786  
00001692  5339 00001CF6            787      SUB.B   #1,         FLARE_COOLDOWN ; Tick down cooldown
00001698  6000 0024                788      BRA     TP_DONE
0000169C                           789  
0000169C                           790      ; Priority 4: idle - roll for new flare
0000169C                           791  TP_IDLE:
0000169C  4EB9 00001AF8            792      JSR     RANNUM                  ; Returns 0-31 in D2
000016A2  4A02                     793      TST.B   D2
000016A4  6600 0018                794      BNE     TP_DONE                 ; Non-zero: no flare this tick
000016A8                           795  
000016A8                           796      ; Start the warning phase
000016A8  13FC 0001 00001CF4       797      MOVE.B  #1,         FLARE_WARNING
000016B0  13FC 0010 00001CF5       798      MOVE.B  #FLARE_WARN_TICKS,FLARE_WARN_TIMER
000016B8  4239 00001CF7            799      CLR.B   WARN_FLASH              ; Start flash from 0
000016BE                           800  
000016BE                           801  TP_DONE:
000016BE  4E75                     802      RTS
000016C0                           803  
000016C0                           804  *-----------------------------------------------------------
000016C0                           805  * Subroutine    : Dynamic Delay
000016C0                           806  * Description   : Halves loop count during boost for speed burst.
000016C0                           807  *-----------------------------------------------------------
000016C0                           808  
000016C0                           809  DYNAMIC_DELAY:
000016C0  48E7 8000                810      MOVEM.L D0,         -(SP)
000016C4  2039 00001CEA            811      MOVE.L  DELAY_COUNT,D0
