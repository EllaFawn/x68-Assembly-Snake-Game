000012F2                           390  RK_BOOST:
000012F2                           391      ; Space toggles boost. Pressing again while active turns it OFF.
000012F2                           392      ; Turning ON requires enough fuel for at least one boosted tick.
000012F2  4A39 00001CF8            393      TST.B   BOOST_ACTIVE
000012F8  6600 0020                394      BNE     RK_BOOST_OFF            ; Already on: turn off
000012FC                           395  
