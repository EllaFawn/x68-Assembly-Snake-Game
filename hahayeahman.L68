000012FC  1239 00001CEF            397      MOVE.B  FUEL,       D1
00001302  B23C 0003                398      CMP.B   #BOOST_EXTRA,D1
00001306  6DC0                     399      BLT     RK_DONE                 ; Not enough fuel: ignore
00001308  13FC 0001 00001CF8       400      MOVE.B  #1,         BOOST_ACTIVE
