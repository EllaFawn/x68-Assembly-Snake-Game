00001282                           342  *-----------------------------------------------------------
00001282                           343  * Subroutine    : Read Keys
00001282                           344  * Description   : Polls task 19. Handles ESC, Space (boost),
00001282                           345  *                 and arrow keys. SPACE must be checked before
00001282                           346  *                 the arrow chain because $20 < $25.
00001282                           347  *-----------------------------------------------------------
00001282                           348  
00001282                           349  READ_KEYS:
00001282  4281                     350      CLR.L   D1
00001284  103C 0013                351      MOVE.B  #TC_KEYCODE,D0
00001288  4E4F                     352      TRAP    #15
0000128A                           353  
0000128A  4A01                     354      TST.B   D1
0000128C  6700 003A                355      BEQ     RK_DONE                 ; 0 = no key yet
00001290                           356  
00001290                           357      ; Easy68k swallows $1B at simulator level so Q/q is used to quit
00001290  B23C 0071                358      CMP.B   #ESCAPE_LO, D1          ; 'q' lowercase ?
00001294  6700 07BA                359      BEQ     EXIT
00001298  B23C 0051                360      CMP.B   #ESCAPE_HI, D1          ; 'Q' uppercase ?
0000129C  6700 07B2                361      BEQ     EXIT
000012A0                           362  
000012A0  B23C 0020                363      CMP.B   #SPACE,     D1          ; MUST be before arrow chain ($20 < $25)
000012A4  6700 004C                364      BEQ     RK_BOOST
000012A8  B23C 0025                365      CMP.B   #$25,       D1
000012AC  6700 001C                366      BEQ     RK_LEFT
000012B0  B23C 0026                367      CMP.B   #$26,       D1
000012B4  6700 001E                368      BEQ     RK_UP
000012B8  B23C 0027                369      CMP.B   #$27,       D1
000012BC  6700 0020                370      BEQ     RK_RIGHT
000012C0  B23C 0028                371      CMP.B   #$28,       D1
000012C4  6700 0022                372      BEQ     RK_DOWN
